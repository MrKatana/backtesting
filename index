(function(){
  var tabs=[].slice.call(document.querySelectorAll('.tab'));
  function mostrar(id){
    tabs.forEach(function(t){
      var on=t.dataset.panel===id;
      t.setAttribute('aria-selected',on?'true':'false');
      document.getElementById(t.dataset.panel).hidden=!on;
      if(on&&t.scrollIntoView)t.scrollIntoView({block:'nearest',inline:'nearest'});
    });
    window.scrollTo({top:0,behavior:'instant'});
  }
  tabs.forEach(function(t){
    t.addEventListener('click',function(){mostrar(t.dataset.panel);});
    t.addEventListener('keydown',function(e){
      var i=tabs.indexOf(t),n=null;
      if(e.key==='ArrowRight')n=tabs[(i+1)%tabs.length];
      if(e.key==='ArrowLeft')n=tabs[(i-1+tabs.length)%tabs.length];
      if(n){e.preventDefault();n.focus();mostrar(n.dataset.panel);}
    });
  });
})();
</script>
