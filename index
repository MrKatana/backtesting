<style>

:root{
  color-scheme: light;
  --ground:#eef0ec; --panel:#f8f9f6; --panel-2:#e6e9e3;
  --ink:#14181a; --ink-2:#3c4547; --muted:#5b6462; --faint:#8b9491;
  --rule:#d3d8d2; --rule-strong:#b9c0b8;
  --petrol:#0073a3; --brick:#bf4126; --green:#35986a;
  --petrol-soft:#0073a31f; --brick-soft:#bf41261f; --green-soft:#35986a1f;
  --shadow:0 1px 2px #14181a0d, 0 8px 24px #14181a0a;
  --serif:"Spectral",Georgia,"Times New Roman",serif;
  --sans:"IBM Plex Sans","Helvetica Neue",Arial,sans-serif;
  --mono:"IBM Plex Mono","SF Mono",Consolas,monospace;
  --col:37rem; --wide:64rem;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --ground:#15191b; --panel:#1d2224; --panel-2:#252b2d;
    --ink:#eef0ec; --ink-2:#c4ccc9; --muted:#9aa4a2; --faint:#6e7876;
    --rule:#2c3335; --rule-strong:#3d4548;
    --petrol:#3d9dcb; --brick:#e0684c; --green:#4fb185;
    --petrol-soft:#3d9dcb24; --brick-soft:#e0684c24; --green-soft:#4fb18524;
    --shadow:0 1px 2px #0006, 0 8px 24px #0004;
  }
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --ground:#15191b; --panel:#1d2224; --panel-2:#252b2d;
  --ink:#eef0ec; --ink-2:#c4ccc9; --muted:#9aa4a2; --faint:#6e7876;
  --rule:#2c3335; --rule-strong:#3d4548;
  --petrol:#3d9dcb; --brick:#e0684c; --green:#4fb185;
  --petrol-soft:#3d9dcb24; --brick-soft:#e0684c24; --green-soft:#4fb18524;
  --shadow:0 1px 2px #0006, 0 8px 24px #0004;
}
*{box-sizing:border-box}
body{margin:0; background:var(--ground); color:var(--ink); font-family:var(--sans);
  font-size:16px; line-height:1.62; -webkit-font-smoothing:antialiased}

/* ---------------- barra de pestanas ---------------- */
.tabbar{position:sticky; top:0; z-index:50; background:var(--ground);
  border-bottom:1px solid var(--rule); box-shadow:0 1px 0 var(--rule)}
.tabbar-in{max-width:var(--wide); margin:0 auto; padding:0 1.5rem; display:flex; gap:.4rem;
  overflow-x:auto; scrollbar-width:thin}
.tab{appearance:none; background:none; border:0; border-bottom:2px solid transparent;
  padding:.8rem .65rem .65rem; cursor:pointer; text-align:left; white-space:nowrap;
  color:var(--muted); font-family:var(--sans); font-size:.85rem; line-height:1.25;
  border-radius:3px 3px 0 0; transition:color .12s, border-color .12s, background .12s}
.tab:hover{color:var(--ink); background:var(--panel-2)}
.tab .exp{display:block; font-family:var(--mono); font-size:.63rem; letter-spacing:.14em;
  text-transform:uppercase; color:var(--faint); margin-bottom:.12rem}
.tab .nm{font-weight:500}
.tab[aria-selected="true"]{color:var(--ink); border-bottom-color:var(--brick); background:transparent}
.tab[aria-selected="true"] .exp{color:var(--brick)}
.tab[aria-selected="true"] .nm{font-weight:600}
.tab:focus-visible{outline:2px solid var(--petrol); outline-offset:-2px}
.panelw[hidden]{display:none!important}

/* ===== e1a · Diez Mil Vidas de un Trader ===== */







.page{max-width:var(--wide); margin:0 auto; padding:0 1.5rem 6rem}
.col{max-width:var(--col); margin-left:auto; margin-right:auto}
p{margin:0 0 1.1em; color:var(--ink-2)}
strong{color:var(--ink); font-weight:600}
a{color:var(--petrol)}
h1,h2,h3{font-family:var(--serif); font-weight:600; text-wrap:balance; color:var(--ink); margin:0}
em{font-style:italic}

/* ---------- rail label ---------- */
.rail{
  font-family:var(--mono); font-size:.68rem; font-weight:500;
  letter-spacing:.13em; text-transform:uppercase; color:var(--faint);
  display:flex; align-items:center; gap:.7rem;
}
.rail::after{content:""; flex:1; height:1px; background:var(--rule)}

/* ---------- hero ---------- */
.hero{padding:5.5rem 0 3rem; border-bottom:1px solid var(--rule)}
.kicker{
  font-family:var(--mono); font-size:.72rem; letter-spacing:.16em;
  text-transform:uppercase; color:var(--brick); margin-bottom:1.6rem;
}
h1{font-size:clamp(2.6rem,7vw,4.6rem); line-height:1.02; letter-spacing:-.022em; font-weight:800}
h1 .thin{font-weight:400; font-style:italic; color:var(--muted)}
.standfirst{
  font-family:var(--serif); font-size:1.24rem; line-height:1.55;
  color:var(--ink-2); margin-top:1.6rem; max-width:34rem;
}
.byline{
  margin-top:2.4rem; font-family:var(--mono); font-size:.74rem;
  color:var(--faint); line-height:1.9;
}

/* ---------- headline figures ---------- */
.figs{
  display:grid; grid-template-columns:repeat(2,1fr);
  gap:1px; background:var(--rule); border:1px solid var(--rule);
  margin:3rem 0 0; border-radius:3px; overflow:hidden;
}
.fig{background:var(--panel); padding:1.3rem 1.2rem}
.fig .n{
  font-family:var(--mono); font-size:1.85rem; font-weight:600;
  letter-spacing:-.03em; line-height:1.1; font-variant-numeric:tabular-nums;
}
.fig .n.neg{color:var(--brick)}
.fig .n.pos{color:var(--green)}
.fig .l{font-size:.78rem; color:var(--muted); margin-top:.45rem; line-height:1.4}

/* ---------- sections ---------- */
section{padding:4.2rem 0 0}
h2{font-size:clamp(1.7rem,3.4vw,2.3rem); line-height:1.13; letter-spacing:-.015em; margin:1.1rem 0 1.1rem}
h3{font-size:1.13rem; line-height:1.35; margin:2.2rem 0 .6rem; font-weight:600}
.lede{font-size:1.06rem; color:var(--ink-2)}

/* ---------- panel ---------- */
.panel{
  background:var(--panel); border:1px solid var(--rule); border-radius:4px;
  padding:1.5rem 1.5rem 1.6rem; margin:2rem auto; box-shadow:var(--shadow);
  max-width:var(--wide);
}
.panel > .rail{margin-bottom:1.2rem}
.panel .cap{font-size:.85rem; color:var(--muted); margin:1.1rem 0 0; line-height:1.5}
.panel .cap b{color:var(--ink-2); font-weight:600}

/* ---------- pull ---------- */
.pull{
  border-left:2px solid var(--brick); padding:.2rem 0 .2rem 1.3rem;
  margin:2.2rem 0; font-family:var(--serif); font-size:1.3rem;
  line-height:1.45; color:var(--ink);
}

/* ---------- bar chart (CSS) ---------- */
.bars{display:grid; gap:.5rem; font-variant-numeric:tabular-nums; padding-right:4.4rem}
.bar{display:grid; grid-template-columns:minmax(0,13.5rem) 1fr; gap:1rem; align-items:center}
.bar .k{font-size:.83rem; color:var(--ink-2); line-height:1.3}
.bar .k small{display:block; color:var(--faint); font-size:.72rem; font-family:var(--mono)}
.track{position:relative; height:1.6rem; display:flex; align-items:center}
.track .zero{position:absolute; top:-.15rem; bottom:-.15rem; width:1px; background:var(--rule-strong)}
.fill{
  position:absolute; height:1.25rem; border-radius:0 3px 3px 0; background:var(--petrol);
  display:flex; align-items:center;
}
.fill.left{border-radius:3px 0 0 3px; justify-content:flex-start}
.fill.neg{background:var(--brick)} .fill.pos{background:var(--green)}
.val{font-family:var(--mono); font-size:.75rem; font-weight:500; color:var(--ink-2); white-space:nowrap}
.val.inside{color:var(--panel); padding:0 .5rem}
.val.outside{position:absolute}
.bar.hi .k{color:var(--ink); font-weight:600}

/* ---------- tables ---------- */
.tw{overflow-x:auto; margin:1rem 0 0; -webkit-overflow-scrolling:touch}
table{border-collapse:collapse; width:100%; font-size:.86rem; min-width:32rem}
th,td{text-align:right; padding:.5rem .7rem; border-bottom:1px solid var(--rule)}
th:first-child,td:first-child{text-align:left}
thead th{
  font-family:var(--mono); font-size:.68rem; letter-spacing:.07em; text-transform:uppercase;
  color:var(--faint); font-weight:500; border-bottom:1px solid var(--rule-strong); white-space:nowrap;
}
tbody td{font-variant-numeric:tabular-nums; color:var(--ink-2)}
tbody tr:hover td{background:var(--panel-2)}
tbody tr.hi td{background:var(--petrol-soft); color:var(--ink)}
td.neg{color:var(--brick)} td.pos{color:var(--green)}
td.mono,th.mono{font-family:var(--mono); white-space:nowrap}

/* ---------- ranked findings ---------- */
.finding{
  display:grid; grid-template-columns:2.6rem 1fr; gap:1.1rem;
  padding:1.4rem 0; border-top:1px solid var(--rule);
}
.finding .rank{
  font-family:var(--mono); font-size:.8rem; font-weight:600; color:var(--brick);
  padding-top:.32rem; letter-spacing:.02em;
}
.finding h3{margin:0 0 .35rem}
.finding p{margin:0; font-size:.95rem}
.chip{
  display:inline-flex; align-items:baseline; gap:.4rem; margin-top:.7rem;
  font-family:var(--mono); font-size:.74rem; padding:.22rem .55rem;
  border:1px solid var(--rule-strong); border-radius:2px; color:var(--muted);
  background:var(--panel-2);
}
.chip b{font-weight:600; color:var(--ink); font-variant-numeric:tabular-nums}

/* ---------- callout ---------- */
.callout{
  border:1px solid var(--brick); border-left-width:3px; background:var(--brick-soft);
  border-radius:3px; padding:1.2rem 1.3rem; margin:2rem auto; max-width:var(--col);
}
.callout .rail{color:var(--brick)} .callout .rail::after{background:var(--brick);opacity:.3}
.callout p{margin:.8rem 0 0; color:var(--ink-2); font-size:.95rem}
.callout p:first-of-type{margin-top:.7rem}

/* ---------- svg chart ---------- */
.svgwrap{overflow-x:auto}
svg{display:block; max-width:100%; height:auto}
.ax{stroke:var(--rule); stroke-width:1}
.axl{fill:var(--faint); font-family:var(--mono); font-size:10px}
.gl{stroke:var(--rule); stroke-width:1; stroke-dasharray:2 3}

/* ---------- footer ---------- */
footer{
  margin-top:4rem; padding:2.2rem 0 0; border-top:1px solid var(--rule);
  font-size:.85rem; color:var(--muted);
}
footer h3{font-size:1rem; margin:1.6rem 0 .4rem}
footer ul{margin:0; padding-left:1.1rem} footer li{margin:.3rem 0}
.disc{
  margin-top:2.4rem; padding:1rem 1.1rem; border:1px dashed var(--rule-strong);
  border-radius:3px; font-size:.8rem; color:var(--faint); line-height:1.6;
}
@media (max-width:640px){
  .bar{grid-template-columns:1fr; gap:.15rem}
  .hero{padding:3.5rem 0 2.5rem}
  section{padding:3rem 0 0}
}

